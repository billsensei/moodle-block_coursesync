{{!
    @template block_coursesync/block_content

    The body of the Course sync block on a course page.

    Context variables required for this template:
    * uniqid string - Unique id tying this markup to its JavaScript.
    * blockid int - The block instance being shown.
    * configured bool - Whether a verified connection exists.
    * cansetup bool - Whether this user may finish the setup.
    * hasremote bool - Whether the remote site and course are known.
    * remotesitename string - Name of the remote site.
    * remotecoursename string - Name of the remote course.
    * summary string - Short description of how many activities are synced or in conflict.
    * hasconflicts bool - Whether anything needs review.
    * conflicts int - How many activities need review.
    * canresolve bool - Whether this user may open the conflict review.
    * conflictsurl string - Link to the conflict review.
    * haslastrun bool - Whether a run has ever happened.
    * lastrun string - When the last run finished.
    * running bool - Whether a run is queued or in progress.
    * cantrigger bool - Whether this user may check for and start a run.
    * available object - What the last check found; see block_coursesync/available_list.
      While it holds activities, that list carries its own Sync now for the chosen
      ones and the whole-course Sync now below is hidden.
    * syncurl string - Where the sync form posts to.
    * returnurl string - Where to return after starting a run.
    * sesskey string - Session key for the sync form.
    * canviewhistory bool - Whether this user may see the history.
    * historyurl string - Link to the history page.

    Example context (json):
    {
        "uniqid": "block_coursesync_status_1",
        "blockid": 6,
        "configured": true,
        "cansetup": true,
        "hasremote": true,
        "remotesitename": "Course Sync Site A",
        "remotecoursename": "Source Biology 101",
        "summary": "3 synced, 1 needs review",
        "hasconflicts": true,
        "conflicts": 1,
        "canresolve": true,
        "conflictsurl": "https://example.com/blocks/coursesync/conflicts.php?id=6",
        "haslastrun": true,
        "lastrun": "Saturday, 19 September 2026, 3:42 AM",
        "running": false,
        "cantrigger": true,
        "available": {
            "checked": true,
            "lastchecked": "Saturday, 19 September 2026, 4:10 AM",
            "hasitems": true,
            "count": 1,
            "items": [
                {"remotecmid": 11, "name": "Week 2 reading", "modname": "Page", "isnew": true, "actionlabel": "New"}
            ],
            "error": "",
            "blockid": 6,
            "syncurl": "https://example.com/blocks/coursesync/sync.php",
            "returnurl": "/course/view.php?id=2",
            "sesskey": "abc123"
        },
        "syncurl": "https://example.com/blocks/coursesync/sync.php",
        "returnurl": "/course/view.php?id=2",
        "sesskey": "abc123",
        "canviewhistory": true,
        "historyurl": "https://example.com/blocks/coursesync/history.php?id=6"
    }
}}
<div class="block_coursesync-status" data-region="block_coursesync/status" data-uniqid="{{uniqid}}">
{{#configured}}
    {{#hasremote}}
        <dl class="mb-2">
            <dt class="text-muted">{{#str}}status:from, block_coursesync{{/str}}</dt>
            <dd class="mb-1">{{remotecoursename}}</dd>
            <dd class="mb-0 text-muted small">{{remotesitename}}</dd>
        </dl>
    {{/hasremote}}

    <p class="mb-1">{{summary}}</p>

    {{#haslastrun}}
        <p class="text-muted small mb-2">{{#str}}status:lastrun, block_coursesync{{/str}} {{lastrun}}</p>
    {{/haslastrun}}
    {{^haslastrun}}
        <p class="text-muted small mb-2">{{#str}}status:neverrun, block_coursesync{{/str}}</p>
    {{/haslastrun}}

    {{#hasconflicts}}
        <div class="alert alert-warning py-2 px-3 mb-2" role="alert">
            {{#canresolve}}
                <a href="{{conflictsurl}}">{{#str}}status:reviewconflicts, block_coursesync, {{conflicts}}{{/str}}</a>
            {{/canresolve}}
            {{^canresolve}}
                {{#str}}status:conflictspending, block_coursesync, {{conflicts}}{{/str}}
            {{/canresolve}}
        </div>
    {{/hasconflicts}}

    {{#cantrigger}}
        <div data-region="available" aria-live="polite">
            {{#available}}
                {{> block_coursesync/available_list }}
            {{/available}}
        </div>
    {{/cantrigger}}

    {{#running}}
        <p class="mb-2" data-region="running">
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            {{#str}}status:running, block_coursesync{{/str}}
        </p>
    {{/running}}

    <div class="d-flex flex-wrap gap-2">
        {{^running}}
            {{#cantrigger}}
                <button type="button" class="btn btn-secondary btn-sm" data-action="check">
                    {{#str}}status:checknow, block_coursesync{{/str}}
                </button>
                <div data-region="syncall" {{#available.hasitems}}hidden{{/available.hasitems}}>
                    <form method="post" action="{{syncurl}}" class="m-0">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="id" value="{{blockid}}">
                        <input type="hidden" name="returnurl" value="{{returnurl}}">
                        <button type="submit" class="btn btn-primary btn-sm">
                            {{#str}}status:syncnow, block_coursesync{{/str}}
                        </button>
                    </form>
                </div>
            {{/cantrigger}}
        {{/running}}

        {{#canviewhistory}}
            <a href="{{historyurl}}" class="btn btn-secondary btn-sm">
                {{#str}}status:viewhistory, block_coursesync{{/str}}
            </a>
        {{/canviewhistory}}
    </div>
{{/configured}}

{{^configured}}
    <div class="alert alert-info py-2 px-3 mb-0" role="alert">
        {{#cansetup}}
            {{#str}}status:finishsetup, block_coursesync{{/str}}
        {{/cansetup}}
        {{^cansetup}}
            {{#str}}status:notconfigured, block_coursesync{{/str}}
        {{/cansetup}}
    </div>
{{/configured}}
</div>
{{#configured}}
{{#cantrigger}}
{{#js}}
require(['block_coursesync/checkupdates'], function(CheckUpdates) {
    CheckUpdates.init('{{uniqid}}', {{blockid}});
});
{{/js}}
{{/cantrigger}}
{{/configured}}
{{#running}}
{{#js}}
require(['block_coursesync/syncpoll'], function(SyncPoll) {
    SyncPoll.init('{{uniqid}}', {{blockid}});
});
{{/js}}
{{/running}}
