{{!
    @template block_coursesync/connection_actions

    Buttons that check the remote site and course without saving the form.

    Context variables required for this template:
    * uniqid string - Unique id tying this markup to its JavaScript.
    * blockid int - The block instance being configured.
    * testlabel string - Label for the test connection button.
    * validatelabel string - Label for the validate course button.

    Example context (json):
    {
        "uniqid": "block_coursesync_actions_1",
        "blockid": 42,
        "testlabel": "Test connection",
        "validatelabel": "Validate course"
    }
}}
<div class="block_coursesync-actions" data-region="block_coursesync/connection-actions" data-uniqid="{{uniqid}}">
    <div class="d-flex flex-wrap gap-1 mb-2">
        <button type="button" class="btn btn-secondary" data-action="test-connection">{{testlabel}}</button>
        <button type="button" class="btn btn-secondary" data-action="validate-course">{{validatelabel}}</button>
    </div>
    <div data-region="result" aria-live="polite"></div>
</div>
{{#js}}
require(['block_coursesync/setupwizard'], function(SetupWizard) {
    SetupWizard.init('{{uniqid}}', {{blockid}});
});
{{/js}}
